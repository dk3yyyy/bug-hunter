PORT=3000
GITHUB_MODE=pat
GITHUB_WEBHOOK_SECRET=change-me
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY_PATH=./private-key.pem
# App mode only. Inline PEM contents; wins over GITHUB_PRIVATE_KEY_PATH. Needed on
# hosts that can't mount a file (Render/Railway/Fly). Escaped "\n" is accepted.
GITHUB_PRIVATE_KEY=

# LLM provider. google (default) | openai | anthropic | opencode | deepseek | openrouter | ollama | openai-compatible
LLM_PROVIDER=google

# Google Gemini (default provider)
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL_REVIEW=gemini-flash-latest
GEMINI_MODEL_FAST=gemini-flash-latest

# Other providers (Claude / OpenAI / OpenCode Go / OpenRouter / Ollama / custom)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_REVIEW=
LLM_MODEL_FAST=
# Examples:
#   Claude:   LLM_PROVIDER=anthropic  LLM_API_KEY=sk-ant-...  LLM_MODEL_REVIEW=claude-sonnet-4-5
#   OpenAI:   LLM_PROVIDER=openai     LLM_API_KEY=sk-...       LLM_MODEL_REVIEW=gpt-4o
#   OpenCode: LLM_PROVIDER=opencode   LLM_API_KEY=<oc token>   LLM_MODEL_REVIEW=glm-5.3   (base URL defaults to https://opencode.ai/inference/openai/v1)
#   DeepSeek: LLM_PROVIDER=deepseek   LLM_API_KEY=sk-...       LLM_MODEL_REVIEW=deepseek-chat  (base URL defaults to https://api.deepseek.com/v1)

N8N_HUNT_WEBHOOK_URL=
# Random secret (min 16 chars) guarding /api/hunt, /api/connect and the n8n webhook.
# Generate one: python3 -c "import secrets; print(secrets.token_hex(24))"
N8N_SHARED_SECRET=replace-me-with-a-random-secret-min-16-chars
MAX_FINDINGS=12
CONFIDENCE_THRESHOLD=0.7
BOT_HANDLE=bughunter

# Public URL of this server, reachable by GitHub (a tunnel or a deployment).
# The /connect page pre-fills it; if empty you can paste a URL into the form.
# Localhost won't work for webhooks — use smee/ngrok/cloudflared or deploy.
# On Render/Railway this is filled in automatically from RENDER_EXTERNAL_URL /
# RAILWAY_PUBLIC_DOMAIN; set it by hand only for a custom domain.
PUBLIC_URL=

# GitHub repo URL for the landing page "View the repo" buttons.
LANDING_REPO_URL=https://github.com/dk3yyyy/bug-hunter

# Public URL of a hosted instance. When set, the landing's "Connect a repo"
# button points at <APP_URL>/connect instead of this server's own /connect.
# The GitHub Pages deploy reads the APP_URL repository variable for the same.
APP_URL=
