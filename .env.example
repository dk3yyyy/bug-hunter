PORT=3000
GITHUB_MODE=pat
GITHUB_WEBHOOK_SECRET=change-me
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY_PATH=./private-key.pem

# LLM (default: Google Gemini). For other providers set LLM_PROVIDER + LLM_API_KEY.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL_REVIEW=gemini-flash-latest
GEMINI_MODEL_FAST=gemini-flash-latest

# LLM_PROVIDER: google | openai | anthropic | openrouter | ollama | openai-compatible
LLM_PROVIDER=google
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_REVIEW=
LLM_MODEL_FAST=

N8N_HUNT_WEBHOOK_URL=
N8N_SHARED_SECRET=change-me-too
MAX_FINDINGS=12
CONFIDENCE_THRESHOLD=0.7
BOT_HANDLE=bughunter

# Public URL of this server (for auto-connect to register repo webhooks).
PUBLIC_URL=
