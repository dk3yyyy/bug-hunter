              "id": "a1b2c3d4-0000-4000-8000-000000000501",
              "leftValue": "={{ $('Normalize Hunt Payload').item.json.haunting_level }}",
              "rightValue": "haunted",
              "operator": {
                "type": "string",
                "operation": "equals",
                "singleValue": false
