{
  "name": "🚨 Haunting Alert",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "bughunter-hunt",
        "responseMode": "onReceived",
        "authentication": "headerAuth"
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000001",
      "name": "Bug Hunter Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -200,
        300
      ],
      "webhookId": "bughunter-hunt",
      "credentials": {
        "headerAuth": {
          "id": null,
          "name": "BugHunter Header Auth — REPLACE ME"
        }
      }
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "a1b2c3d4-0000-4000-8000-000000000201",
              "name": "creature_label",
              "value": "={{ $json.haunting_level === 'possessed' ? '💀 Possessed' : $json.haunting_level === 'haunted' ? '👻 Haunted' : $json.haunting_level === 'restless' ? '🦇 Restless' : $json.haunting_level === 'whispers' ? '🕯️ Whispers' : '🌕 Clear' }}",
              "type": "string"
            },
            {
              "id": "a1b2c3d4-0000-4000-8000-000000000202",
              "name": "total_spirits",
              "value": "={{ ($json.counts.critical || 0) + ($json.counts.high || 0) + ($json.counts.medium || 0) + ($json.counts.low || 0) }}",
              "type": "number"
            },
            {
              "id": "a1b2c3d4-0000-4000-8000-000000000203",
              "name": "timestamp",
              "value": "={{ $json.finished_at ? new Date($json.finished_at).toLocaleString() : new Date().toISOString() }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000002",
      "name": "Normalize Hunt Payload",
