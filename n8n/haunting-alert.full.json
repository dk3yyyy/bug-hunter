            "version": 2
          },
          "conditions": [
            {
              "id": "a1b2c3d4-0000-4000-8000-000000000301",
              "leftValue": "={{ $json.repo }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": false
              }
            },
            {
              "id": "a1b2c3d4-0000-4000-8000-000000000302",
              "leftValue": "={{ $json.pr_number }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": false
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000003",
