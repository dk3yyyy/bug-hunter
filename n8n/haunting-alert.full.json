      "id": "a1b2c3d4-0000-4000-8000-000000000005",
      "name": "Haunted or Possessed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "sendTo": "REPLACE_WITH_DEMO_INBOX@example.com",
        "subject": "=🎃 Bug Hunter: PR #{{ $('Normalize Hunt Payload').item.json.pr_number }} is {{ $('Normalize Hunt Payload').item.json.haunting_level }}",
        "emailType": "html",
        "message": "={{ (() => { const p = $('Normalize Hunt Payload').item.json; const e = (s => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')); const items = (p.top_findings || []).map(f => '<li><b>' + e(f.severity) + '</b>: ' + e(f.title) + ' (<code>' + e(f.file) + ':' + e(f.line) + '</code>)</li>').join(''); return '<h2>' + e(p.creature_label) + ': PR #' + e(p.pr_number) + '</h2>' + '<p><b>' + e(p.repo) + '</b>: ' + e(p.pr_title) + '</p>' + '<p>Spirits found: ' + e(p.total_spirits) + ' · false alarms exorcised: ' + e(p.false_alarms_exorcised || 0) + '</p>' + (items ? '<ul>' + items + '</ul>' : '') + (p.possession_attempt ? '<p>🪄 Someone tried to possess the reviewer. Bug Hunter resisted.</p>' : '') + '<p><a href=\"' + e(p.pr_url) + '\">Open the pull request</a></p>'; })() }}",
        "options": {
          "appendAttribution": false
        }
      },
