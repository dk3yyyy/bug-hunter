    "@octokit/webhooks": "^13.0.0",
    "ai": "^4.3.0",
    "hono": "^4.6.0",
    "p-queue": "^8.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
